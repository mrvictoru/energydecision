FROM docker.io/nvidia/cuda:13.0.2-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-ttm.txt /tmp/requirements-ttm.txt
RUN python3 -m pip install --break-system-packages -r /tmp/requirements-ttm.txt

WORKDIR /workspace
